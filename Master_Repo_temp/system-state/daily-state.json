  "replication": {
    "purpose": "Clone entire OpenClaw setup to new VPS",
    "steps": [
      "1. Clone Daily-Working-Space: git clone https://github.com/itsaslamopenclawdata/Daily-Working-Space.git",
      "2. Clone Master_Repo: git clone https://github.com/itsaslamopenclawdata/Master_Repo.git",
      "3. Install OpenClaw: curl -sSL https://get.openclaw.ai | sh",
      "4. Copy config: cp system-state/openclaw.json ~/.openclaw/config.json",
      "5. Restore agents: openclaw agent restore --from system-state/agents/",
      "6. Install skills: cp -r skills/ ~/.openclaw/skills/",
      "7. Setup cron: crontab system-state/crontab.txt"
    ]
  },
